  "cards": [
    {
      "dot": "cyan",
      "title": "两个域",
      "items": [
        "用户域：ForwardAuth 登录，注入身份头与服务绑定令牌",
        "服务域：按源 Pod IP 识别调用方，本地评估放行表",
        "接入项目直连公司系统，不经平台出站代理"
      ]
    },
    {
      "dot": "emerald",
      "title": "一任务一 Pod",
      "items": [
        "开发会话是常驻 Pod，TaskRunner 回连 cs-session",
        "每个 CLI／Agent／业务子任务各一个执行 Pod",
        "工作卷随开发容器；业务任务可选持久卷"
      ]
    },
    {
      "dot": "rose",
      "title": "数据",
      "items": [
        "每服务一份生产库与一份开发库，两槽共用生产库",
        "本机所有库在同一个 PostgreSQL 实例，与 Design §9.2 有差距",
        "发布时迁移 Job 使用迁移身份，必须与线上槽兼容"
      ]
    }
