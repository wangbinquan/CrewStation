{
  "name": "crewstation",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "modules/*", "packages/*", "runtimes/*", "tools/*"],
  "scripts": {
    "arch:check": "bun run tools/arch/check.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:console": "tsc -p apps/console/tsconfig.json --noEmit",
    "test": "bun test",
    "check": "bun run arch:check && bun run lint && bun run typecheck && bun run typecheck:console && bun test",
    "scaffold:module": "bun run tools/scaffold/newModule.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@types/bun": "1.4.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6",
    "typescript-eslint": "8.70.0"
  }
}
